// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Connection URLs live in prisma.config.ts (required by Prisma 7).
  // Runtime app uses DATABASE_URL via the pg adapter in lib/prisma.ts;
  // Prisma CLI commands (migrate, db push) use DIRECT_URL configured
  // in prisma.config.ts.
}

// ============================================
// ENUMS
// ============================================

/// Legacy global role (being phased out — see the note on
/// User.role). Renamed from `Role` when the per-company custom
/// Role model was introduced so the two don't collide.
enum UserRole {
  ADMIN
  TEAM
  MEMBER
}

// ============================================
// MULTI-TENANCY (Phase 1 — see docs/multi-tenancy.md)
// ============================================
//
// Role a user carries inside a specific Company. Distinct from
// User.role (which is being phased out — will be dropped in Phase 7).
// Per-company scope: one user can be OWNER in Company A and MEMBER
// in Company B.
enum CompanyRole {
  OWNER // Full control of the company; can invite ADMINs, change branding, delete the company
  ADMIN // Everything except deleting the company + swapping the owner
  TEAM // Internal team member — same as today's TEAM role
  MEMBER // Student — same as today's MEMBER role
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

/// Who can see a course beyond admins.
/// - MEMBERS:  shown in the member catalog only (default).
/// - INTERNAL: shown only to internal/admin team — hidden from members.
/// - BOTH:     shown in the member catalog AND the internal section.
enum CourseAudience {
  MEMBERS
  INTERNAL
  BOTH
}

enum LessonType {
  VIDEO
  QUIZ
  RESOURCE
}

enum LessonStatus {
  DRAFT
  PROCESSING
  READY
}

enum QuestionType {
  MULTIPLE_CHOICE
  TRUE_FALSE
}

enum AnnouncementStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
}

enum AnnouncementCategory {
  GENERAL
  OFFICE_HOURS
  COURSE_UPDATE
  IMPORTANT
}

enum AnnouncementAuditAction {
  CREATED
  UPDATED
  PUBLISHED
  UNPUBLISHED
  DELETED
  RESTORED
}

enum EnrollmentStatus {
  PENDING
  ACTIVE
  // Course finished — `completedAt` is set, the user keeps access until
  // `expiresAt`. Distinct from ACTIVE so cohort filters can split
  // "currently learning" from "already completed" without re-deriving
  // the state from progressPercent or completedAt.
  COMPLETED
  EXPIRED
  REVOKED
}

enum EnrollmentSource {
  MANUAL
  GHL_WEBHOOK
  ADMIN
  SELF_ENROLL
}

/// Employment lifecycle state for an internal Employee record.
enum EmploymentStatus {
  ACTIVE
  OFFBOARDED
}

/// Per-item state on an employee's onboarding checklist. Mirrors the
/// original spreadsheet vocabulary:
///   OK        – done / verified ("ok" in the sheet)
///   PENDING   – not yet done ("x" in the sheet)
///   ATTENTION – flagged, needs follow-up ("!" in the sheet)
///   NA        – not applicable to this role (blank in the sheet)
enum ChecklistItemStatus {
  OK
  PENDING
  ATTENTION
  NA
}

/// Level of an org-board node inside its revision. All nodes share
/// a single self-referencing table; `kind` disambiguates rendering
/// and drives which parents/children are allowed. Modelled after
/// L. Ron Hubbard's classic 7-division org board.
///   CROWN      – Founder / Executive Director / Deputy / VP.
///                Sits above the divisions; typically a linear chain.
///   DIVISION   – One of the 7 coloured columns.
///   DEPARTMENT – Standard Hubbard dept (1-21) inside a division.
///   SECTION    – A named group inside a department (optional).
///   UNIT       – A sub-group inside a section (optional, rare).
///   POSITION   – A role that a single Employee can hold. Positions
///                may nest under any of the above levels.
enum OrgNodeKind {
  CROWN
  DIVISION
  DEPARTMENT
  SECTION
  UNIT
  POSITION
}

/// Employment classification for a Position assignment. Broad enough
/// to cover contractors and interns while staying a small enum so
/// filters and reports can stay typed.
enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERN
  ADVISORY
}

/// Kinds of changes we log on the org board. Kept small on purpose;
/// finer distinctions live in the `newValue` JSON payload.
enum OrgAuditAction {
  NODE_CREATED
  NODE_UPDATED
  NODE_MOVED
  NODE_DELETED
  ASSIGNMENT_ADDED
  ASSIGNMENT_ENDED
}

// ============================================
// USER MANAGEMENT
// ============================================

model User {
  id                      String    @id @default(uuid())
  authId                  String?   @unique @map("auth_id") // Supabase auth.users.id
  email                   String    @unique
  name                    String?
  avatarUrl               String?   @map("avatar_url")
  /// Legacy global role. Being phased out in favour of
  /// CompanyMembership.role once every code path reads the active
  /// company's membership. Kept for Phase 1 so nothing else breaks.
  role                    UserRole  @default(MEMBER)
  /// Global super-admin flag. Grants the ability to enter any
  /// Company as a super-admin (Keanu at the agency level).
  /// Independent of memberships — the master key.
  isSuperAdmin            Boolean   @default(false) @map("is_super_admin")
  isActive                Boolean   @default(true) @map("is_active")
  emailVerified           Boolean   @default(false) @map("email_verified")
  lastLoginAt             DateTime? @map("last_login_at")
  /// Stamped by getUser() on every authenticated page request,
  /// debounced to once per 15 minutes per user. Powers the "Last
  /// active" column on /admin/team and /admin/members so the value
  /// reflects any URL access, not just explicit sign-in.
  lastActiveAt            DateTime? @map("last_active_at")
  /**
   * When the member last opened the announcements feed. Powers the
   * "New since your last visit" divider; updated server-side when
   * /announcements renders.
   */
  announcementsLastSeenAt DateTime? @map("announcements_last_seen_at")
  /**
   * Per-user notification opt-out. Defaults true so current behaviour
   * is preserved; members can disable from the preferences page.
   */
  notifyAnnouncementEmail Boolean   @default(true) @map("notify_announcement_email")
  /**
   * Optional category tier. When set, the member sees published
   * courses that either share this category, are marked isFree, or
   * have no categories at all. ADMIN/TEAM roles bypass the check.
   * Null = no tier assigned; member only sees free + uncategorized.
   */
  membershipId            String?   @map("membership_id")
  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @updatedAt @map("updated_at")
  deletedAt               DateTime? @map("deleted_at")

  // Relations
  membership            Membership?            @relation(fields: [membershipId], references: [id], onDelete: SetNull)
  enrollments           Enrollment[]
  lessonProgress        LessonProgress[]
  quizAttempts          QuizAttempt[]
  notes                 Note[]
  announcementReads     AnnouncementRead[]
  announcementsAuthored Announcement[]         @relation("AnnouncementAuthor")
  announcementComments  AnnouncementComment[]
  announcementReactions AnnouncementReaction[]
  announcementAuditLogs AnnouncementAuditLog[]
  invites               Invite[]
  loginEvents           LoginEvent[]
  auditLogEntries       AuditLog[]             @relation("AuditLogActor")
  appSettingsUpdated    AppSetting[]           @relation("AppSettingUpdater")
  certificateIssuances  CertificateIssuance[]
  certsManuallyIssued   CertificateIssuance[]  @relation("CertsManuallyIssued")
  certsRevoked          CertificateIssuance[]  @relation("CertsRevoked")
  nudgesReceived        Nudge[]                @relation("NudgeRecipient")
  nudgesAuthored        Nudge[]                @relation("NudgeAuthor")
  statDataPointsAdded   StatDataPoint[]        @relation("StatDataPointAuthor")
  employee              Employee?              @relation("EmployeeUser")
  orgBoardRevisions     OrgBoardRevision[]     @relation("OrgBoardRevisionAuthor")
  orgAuditLogs          OrgNodeAuditLog[]      @relation("OrgAuditActor")
  companyMemberships    CompanyMembership[]

  // Super-admin grants — Phase 4.4 replaced the User.isSuperAdmin
  // boolean with a proper table so we get an audit trail + tiered
  // roles + expiration. The boolean column stays for now as a hot-
  // path cache; every grant/revoke writes to both places.
  superAdminGrantsHeld    SuperAdminGrant[] @relation("SuperAdminGrantTarget")
  superAdminGrantsIssued  SuperAdminGrant[] @relation("SuperAdminGrantGrantedBy")
  superAdminGrantsRevoked SuperAdminGrant[] @relation("SuperAdminGrantRevokedBy")

  // Hierarchical settings (Phase 1 white-label task 4). Distinct from
  // AppSetting (which is the legacy flat key/value store).
  settingsUpdated Setting[] @relation("SettingUpdater")

  // Internal Task Tracker — see the TASK TRACKER block near the tail
  // of this file. Relations are named because a user can be attached
  // to a task in several distinct roles (reporter, assignee, watcher,
  // author of a comment, checker of an item, actor on an audit log).
  tasksReported           Task[]              @relation("TaskReporter")
  taskAssignments         TaskAssignee[]
  taskWatches             TaskWatcher[]
  taskComments            TaskComment[]
  taskCommentsEdited      TaskComment[]       @relation("TaskCommentEditor")
  taskChecklistCompletes  TaskChecklistItem[] @relation("TaskChecklistDoneBy")
  taskAttachmentsUploaded TaskAttachment[]    @relation("TaskAttachmentUploader")
  taskActivityLogs        TaskActivityLog[]   @relation("TaskActivityActor")
  taskNotifications       TaskNotification[]  @relation("TaskNotificationRecipient")
  taskNotificationsCaused TaskNotification[]  @relation("TaskNotificationActor")

  // Policies — mini-CMS for internal ops docs (Kondense's Makh-style
  // "hat write-ups"). Named relations because a user can be author,
  // editor, publisher of a revision, uploader of an attachment, or
  // actor on an audit log.
  policiesAuthored          Policy[]            @relation("PolicyAuthor")
  policiesEdited            Policy[]            @relation("PolicyEditor")
  policyRevisionsPublished  PolicyRevision[]    @relation("PolicyRevisionPublisher")
  policyAttachmentsUploaded PolicyAttachment[]  @relation("PolicyAttachmentUploader")
  policyActivityLogs        PolicyActivityLog[] @relation("PolicyActivityActor")

  // Custom-role assignments (permission layer on top of the
  // CompanyMembership tier). One relation because a user is a
  // target of assignments, another because they can hand out
  // assignments to other users. Named relations to keep both.
  roleAssignments       UserRoleAssignment[] @relation("UserRoleAssignmentTarget")
  roleAssignmentsIssued UserRoleAssignment[] @relation("UserRoleAssignmentGrantedBy")

  // Production sheet — setter/closer daily numbers + appointment log.
  productionEntries  ProductionEntry[]
  productionTargets  ProductionTarget[]
  appointmentsSet    AppointmentSet[]   @relation("AppointmentSetSetter")
  appointmentsClosed AppointmentSet[]   @relation("AppointmentSetCloser")

  // CRM — sales pipeline. A user shows up as the closer a deal is
  // assigned to and as the operator who created the row. Named
  // relations because both point at the same model.
  crmOpportunitiesAssigned CrmOpportunity[] @relation("CrmOpportunityCloser")
  crmOpportunitiesCreated  CrmOpportunity[] @relation("CrmOpportunityCreator")

  // CRM — leads. Setter the lead is routed to + operator who
  // captured it.
  crmLeadsAssigned CrmLead[] @relation("CrmLeadSetter")
  crmLeadsCreated  CrmLead[] @relation("CrmLeadCreator")

  // CRM — bulk-action job log (audit of who ran what against the
  // pipeline).
  crmBulkActionsRun CrmBulkAction[] @relation("CrmBulkActionActor")

  // CRM — saved filter views on the Opportunities board (one per
  // user; the user owns their private views).
  crmOpportunityViews CrmOpportunityView[] @relation("CrmOpportunityViewOwner")
  // CRM — same pattern for the Contacts inbox (GHL "Smart Lists").
  crmContactViews     CrmContactView[]     @relation("CrmContactViewOwner")

  // CRM — opportunity task/note authorship + assignment. Tasks track
  // both who created the row and who's meant to complete it; notes
  // just track authorship. SetNull on user delete so history survives.
  crmOpportunityTasksCreated  CrmOpportunityTask[] @relation("CrmOpportunityTaskCreator")
  crmOpportunityTasksAssigned CrmOpportunityTask[] @relation("CrmOpportunityTaskAssignee")
  crmOpportunityNotesAuthored CrmOpportunityNote[] @relation("CrmOpportunityNoteAuthor")

  @@index([role])
  @@index([isActive])
  @@index([deletedAt])
  @@index([isSuperAdmin])
  @@map("users")
}

// ============================================
// SUPER-ADMIN GRANTS
// ============================================

/// Grants the super-admin master key to a user. One user can have
/// many rows over time (grant → revoke → re-grant); only one row
/// with revokedAt IS NULL is legal at any given moment.
///
/// The User.isSuperAdmin boolean is kept in sync as a hot-path
/// cache — gate checks read the boolean, not this table. Phase 7
/// drops the boolean once every reader has been switched over.
///
/// The former `role` column (MASTER/SUPPORT/AUDITOR) was dropped —
/// no gate ever consulted it, so tiering was cosmetic. In the
/// single-tier operator model, a grant is a grant.
model SuperAdminGrant {
  id          String    @id @default(uuid())
  userId      String    @map("user_id")
  /// Who granted the flag. Null when the row was seeded via SQL
  /// during a migration (pre-4.4 backfill, break-glass).
  grantedById String?   @map("granted_by_id")
  grantedAt   DateTime  @default(now()) @map("granted_at")
  /// Optional expiry — after this instant the grant is treated as
  /// revoked by the hot-path check. Null = never expires.
  expiresAt   DateTime? @map("expires_at")
  revokedAt   DateTime? @map("revoked_at")
  revokedById String?   @map("revoked_by_id")
  /// Free-form justification: ticket #, requester name, etc. Kept
  /// short (255 char cap enforced app-side).
  notes       String?

  user      User  @relation("SuperAdminGrantTarget", fields: [userId], references: [id], onDelete: Cascade)
  grantedBy User? @relation("SuperAdminGrantGrantedBy", fields: [grantedById], references: [id], onDelete: SetNull)
  revokedBy User? @relation("SuperAdminGrantRevokedBy", fields: [revokedById], references: [id], onDelete: SetNull)

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("super_admin_grants")
}

// ============================================
// COMPANIES  (multi-tenancy — see docs/multi-tenancy.md)
// ============================================

/// A tenant. Every company sees only its own courses, members,
/// stats, certificates, etc. Users can belong to many companies
/// via CompanyMembership.
///
/// The seed row on migration is "Kondense" — all existing data is
/// backfilled to belong to it, so pre-tenancy accounts land
/// exactly where they were before.
model Company {
  id           String    @id @default(uuid())
  slug         String    @unique
  name         String
  /// True only for the Kondense parent row today. Not load-bearing
  /// for auth (super-admin is a global flag on User); reserved for
  /// future cross-tenant analytics anchoring.
  isAgency     Boolean   @default(false) @map("is_agency")
  /// White-label config: logo, favicon, primary + accent colors,
  /// product name shown in the sidebar, email `from` name, etc.
  /// Shape validated at the application layer (Phase 5).
  brand        Json?
  /// Deprecated single-domain slot from Phase 1. Kept nullable and
  /// unenforced during the Phase 3 → 4 transition; new writes go to
  /// the `Domain` table (multiple domains per tenant, verified +
  /// SSL state per row). Safe to drop in a later migration once all
  /// callers move to the new table.
  customDomain String?   @unique @map("custom_domain")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  memberships CompanyMembership[]
  domains     Domain[]
  loginEvents LoginEvent[]

  @@index([deletedAt])
  @@map("companies")
}

// ============================================
// DOMAINS (Phase 3 white-label — task 10)
// ============================================

/// A hostname a tenant is reachable at. Two flavours:
///   * MANAGED_SUBDOMAIN — a slug under the platform apex (e.g.
///     `acme.kondense.ai`). Auto-verified since the wildcard cert
///     covers it. No Vercel API call needed.
///   * CUSTOM — a tenant-owned domain (e.g. `portal.acme.com`).
///     Requires TXT-record ownership proof, then Vercel adds it +
///     issues a Let's Encrypt cert.
///
/// Multiple rows per Company are allowed; `isPrimary` marks the
/// preferred one for outbound links. Deleted rows should really be
/// removed (not soft-deleted) so the unique(hostname) constraint
/// can be reused.
enum DomainKind {
  MANAGED_SUBDOMAIN
  CUSTOM
}

model Domain {
  id                String     @id @default(uuid())
  companyId         String     @map("company_id")
  hostname          String     @unique
  kind              DomainKind
  isPrimary         Boolean    @default(false) @map("is_primary")
  /// Set when the TXT-record proof succeeds. Null for un-verified
  /// custom domains; auto-set to now() for managed subdomains.
  verifiedAt        DateTime?  @map("verified_at")
  /// Set when Vercel confirms an SSL cert has been issued (custom
  /// domains only; managed subdomains inherit the wildcard cert and
  /// leave this null).
  sslIssuedAt       DateTime?  @map("ssl_issued_at")
  /// Vercel's internal id for the domain — needed to remove it from
  /// the project when the tenant unlinks.
  vercelDomainId    String?    @map("vercel_domain_id")
  /// Random token the tenant sets as a TXT record at
  /// `_kondense-verify.<hostname>` to prove ownership. Rotated on
  /// every verification retry so an abandoned token can't be reused.
  verificationToken String?    @map("verification_token")
  createdAt         DateTime   @default(now()) @map("created_at")
  updatedAt         DateTime   @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([verifiedAt])
  @@map("domains")
}

/// Join row between User and Company. Carries the user's role
/// inside that specific company. One user can be OWNER in A,
/// MEMBER in B, ADMIN in C.
model CompanyMembership {
  id        String      @id @default(uuid())
  userId    String      @map("user_id")
  companyId String      @map("company_id")
  role      CompanyRole @default(MEMBER)
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
  @@index([companyId, role])
  @@map("company_memberships")
}

// ============================================
// SETTINGS HIERARCHY (Phase 1 white-label task 4)
// ============================================

/// Scope for a hierarchical Setting row. Resolution order is
/// USER > COMPANY > PLATFORM — narrower scope wins. Every scope has
/// exactly one row per key.
enum SettingScope {
  PLATFORM
  COMPANY
  USER
}

/// Hierarchical key/value store. Replaces the flat `AppSetting`
/// table for anything that will eventually want per-tenant
/// overrides (email `from`, Discord webhooks, feature flags, etc.).
///
/// `scopeId` is non-nullable so the (scope, scope_id, key) unique
/// constraint behaves consistently across Postgres versions:
///   * PLATFORM rows: `scope_id = '00000000-0000-0000-0000-000000000000'`
///     (see lib/settings/scope.ts:PLATFORM_SCOPE_ID)
///   * COMPANY rows: the company id
///   * USER rows: the user id
///
/// `value` is JSON so the same table can hold strings, numbers,
/// booleans, arrays, or objects without schema churn. Callers
/// typecast at the read site (see lib/settings/get-setting.ts).
model Setting {
  id          String       @id @default(uuid())
  scope       SettingScope
  scopeId     String       @map("scope_id")
  key         String
  value       Json
  updatedAt   DateTime     @updatedAt @map("updated_at")
  updatedById String?      @map("updated_by_id")
  updatedBy   User?        @relation("SettingUpdater", fields: [updatedById], references: [id], onDelete: SetNull)

  @@unique([scope, scopeId, key])
  @@index([scope, scopeId])
  @@map("settings")
}

// ============================================
// APP SETTINGS (legacy — being migrated to Setting above)
// ============================================

/// Generic key-value store for admin-configurable platform settings
/// (e.g. Discord webhook URL, future integration tokens, branding).
/// One row per key. Reads are server-only — secret values must never
/// be returned to the client unmasked.
///
/// Kept in the schema during the Phase 1 → 2 transition. New reads +
/// writes go through `Setting` (with backward-compat proxies in
/// lib/services/app-setting-service.ts). This table can be dropped
/// once every caller is verified migrated.
model AppSetting {
  key         String   @id
  value       String
  updatedAt   DateTime @updatedAt @map("updated_at")
  updatedById String?  @map("updated_by_id")
  updatedBy   User?    @relation("AppSettingUpdater", fields: [updatedById], references: [id], onDelete: SetNull)

  companyId String @default("00000000-0000-0000-0000-000000000001") @map("company_id")

  @@map("app_settings")
}

// ============================================
// INVITES
// ============================================

/// Admin-issued onboarding tokens. New members receive a link that
/// embeds the token; the onboarding flow consumes it once to set
/// their initial password.
model Invite {
  id            String    @id @default(uuid())
  token         String    @unique
  userId        String    @map("user_id")
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt     DateTime  @map("expires_at")
  // Set once the password step succeeds. Used to allow re-entry into
  // the wizard for the same authenticated user while keeping anyone
  // else from re-setting the password.
  passwordSetAt DateTime? @map("password_set_at")
  // Set once the final wizard step is reached. After this the link is
  // dead and the "Invite invalid" screen takes over.
  usedAt        DateTime? @map("used_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  companyId     String    @default("00000000-0000-0000-0000-000000000001") @map("company_id")

  @@index([userId])
  @@index([token])
  @@map("invites")
}

// ============================================
// LOGIN EVENTS
// ============================================

/// Tracks individual login timestamps per user, scoped to a company.
/// Powers the activity sparkline on the admin members page.
model LoginEvent {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  companyId String   @default("00000000-0000-0000-0000-000000000001") @map("company_id")
  loginAt   DateTime @default(now()) @map("login_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([userId, loginAt])
  @@index([companyId, userId, loginAt])
  @@map("login_events")
}

/// Cross-domain audit trail. Existing per-module logs
/// (TaskActivityLog, PolicyActivityLog, OrgNodeAuditLog,
/// AnnouncementAuditLog, LoginEvent) stay as source of truth for
/// their domains — this table captures everything else that
/// mutates state and matters to an admin: member CRUD, settings
/// changes, course structure edits, membership tier edits,
/// employee onboarding lifecycle, certificate issuance/revoke,
/// etc. The /admin/activity feed unions all of the above.
///
/// `action` is a dot-namespaced token ("member.create",
/// "settings.branding.update") so filters + reports can group
/// naturally. `metadata` is optional structured detail for
/// diffs; the UI shows `summary` as the human-readable one-liner.
model AuditLog {
  id           String   @id @default(uuid())
  /// Nullable — system-triggered actions (background jobs,
  /// automations) have no human actor. SetNull on user delete so
  /// the audit trail survives account cleanup.
  actorId      String?  @map("actor_id")
  action       String
  resourceType String   @map("resource_type")
  /// Optional — actions that don't map to a single row
  /// (e.g. bulk import) leave this null.
  resourceId   String?  @map("resource_id")
  summary      String
  metadata     Json?
  createdAt    DateTime @default(now()) @map("created_at")

  actor User? @relation("AuditLogActor", fields: [actorId], references: [id], onDelete: SetNull)

  companyId String @default("00000000-0000-0000-0000-000000000001") @map("company_id")

  @@index([companyId, createdAt(sort: Desc)])
  @@index([actorId, createdAt(sort: Desc)])
  @@index([resourceType, resourceId])
  @@map("audit_logs")
}

// ============================================
// COURSE STRUCTURE
// ============================================

model Course {
  id                     String         @id @default(uuid())
  title                  String
  // URL-safe identifier used on both public and admin pages. Unique.
  // Auto-derived from title when the admin leaves the field blank;
  // editable for SEO tuning. See lib/utils/slug.ts for generation.
  slug                   String         @unique
  description            String?
  thumbnailUrl           String?        @map("thumbnail_url")
  // Wide 16:9 hero image used on the course detail page. Optional —
  // detail pages fall back to a gradient placeholder when null.
  coverImageUrl          String?        @map("cover_image_url")
  status                 CourseStatus   @default(DRAFT)
  // When true, any signed-in MEMBER can open the course without an
  // Enrollment row. Paid courses leave this false and continue to
  // require enrollment for access. Only meaningful when audience
  // includes MEMBERS (i.e. MEMBERS or BOTH).
  isFree                 Boolean        @default(false) @map("is_free")
  // Who sees this course beyond admins. See CourseAudience for
  // semantics. Defaults to MEMBERS for backwards compatibility.
  audience               CourseAudience @default(MEMBERS)
  orderIndex             Int            @default(0) @map("order_index")
  accessDays             Int?           @map("access_days") // null = forever
  // When true, members who complete this course can download a
  // personalised PDF certificate generated from scratch (Kondense-
  // branded layout in lib/services/certificate-service.ts). Off by
  // default — admins opt in per course so a 10-minute intro doesn't
  // accidentally award a cert.
  certificateEnabled     Boolean        @default(false) @map("certificate_enabled")
  // Deprecated: lingers from the earlier "stamp text onto admin-
  // uploaded template" approach. Replaced by the from-scratch
  // generator; the field is harmless but unused. Safe to drop in a
  // later migration once we're sure we don't want a custom-template
  // override.
  certificateTemplateUrl String?        @map("certificate_template_url")
  publishedAt            DateTime?      @map("published_at")
  createdBy              String?        @map("created_by")
  createdAt              DateTime       @default(now()) @map("created_at")
  updatedAt              DateTime       @updatedAt @map("updated_at")
  deletedAt              DateTime?      @map("deleted_at")

  // Relations
  chapters             Chapter[]
  modules              Module[]
  enrollments          Enrollment[]
  memberships          CourseMembership[]
  certificateIssuances CertificateIssuance[]
  nudges               Nudge[]
  companyId            String                @default("00000000-0000-0000-0000-000000000001") @map("company_id")

  @@index([status])
  @@index([deletedAt])
  @@index([orderIndex])
  @@map("courses")
}

/// Membership tier grouping for members. Admins manage these in
/// /admin/membership; courses opt into a tier via the
/// CourseMembership junction so members only see the library
/// slice their tier grants (plus free / untagged courses).
model Membership {
  id          String   @id @default(uuid())
  name        String   @unique
  slug        String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  courses CourseMembership[]
  members User[]

  companyId String @default("00000000-0000-0000-0000-000000000001") @map("company_id")

  @@map("memberships")
}

/// Junction row connecting a course to a membership tier.
/// Composite PK guarantees a single (course, membership) edge.
/// Both sides cascade on delete so removing a tier cleans up its
/// course associations.
model CourseMembership {
  courseId     String   @map("course_id")
  membershipId String   @map("membership_id")
  createdAt    DateTime @default(now()) @map("created_at")

  course     Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  companyId  String     @default("00000000-0000-0000-0000-000000000001") @map("company_id")

  @@id([courseId, membershipId])
  @@index([membershipId])
  @@map("course_memberships")
}

/// Optional grouping layer between Course and Chapter. A course may
/// have any number of modules; chapters may sit directly on a course
/// (moduleId = null) OR under a module. Modules and loose chapters
/// share the same top-level ordering space (orderIndex on the course).
model Module {
  id          String    @id @default(uuid())
  courseId    String    @map("course_id")
  title       String
  description String?
  orderIndex  Int       @default(0) @map("order_index")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  // Relations
  course               Course                @relation(fields: [courseId], references: [id], onDelete: Cascade)
  chapters             Chapter[]
  certificateIssuances CertificateIssuance[]
  companyId            String                @default("00000000-0000-0000-0000-000000000001") @map("company_id")

  @@index([courseId, orderIndex])
  @@index([deletedAt])
  @@map("modules")
}

model Chapter {
  id         String    @id @default(uuid())
  courseId   String    @map("course_id")
  // Optional parent module. Null means the chapter sits directly on
  // the course (a "loose" chapter). courseId stays denormalized so
  // RLS and ordering queries don't need to traverse the module.
  moduleId   String?   @map("module_id")
  title      String
  orderIndex Int       @default(0) @map("order_index")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")

  // Relations. Module delete uses SetNull so removing a module turns
  // its chapters into loose chapters on the same course rather than
  // cascading the delete down.
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  module    Module?  @relation(fields: [moduleId], references: [id], onDelete: SetNull)
  lessons   Lesson[]
  companyId String   @default("00000000-0000-0000-0000-000000000001") @map("company_id")

  @@index([courseId, orderIndex])
  @@index([moduleId, orderIndex])
  @@map("chapters")
}

model Lesson {
  id          String       @id @default(uuid())
  chapterId   String       @map("chapter_id")
  title       String
  type        LessonType
  status      LessonStatus @default(DRAFT)
  orderIndex  Int          @default(0) @map("order_index")
  description String?

  // Video fields (type = VIDEO)
  muxAssetId      String? @map("mux_asset_id")
  muxPlaybackId   String? @map("mux_playback_id")
  durationSeconds Int?    @map("duration_seconds")

  // Quiz settings (type = QUIZ)
  passingScore Int? @map("passing_score") // Minimum % to pass (e.g., 70)
  maxAttempts  Int? @map("max_attempts") // null = unlimited
  timeLimitMin Int? @map("time_limit_min") // null = no limit

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  // Relations
  chapter        Chapter          @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  quizQuestions  QuizQuestion[]
  lessonProgress LessonProgress[]
  quizAttempts   QuizAttempt[]
  notes          Note[]
  resources      LessonResource[]
  companyId      String           @default("00000000-0000-0000-0000-000000000001") @map("company_id")

  @@index([chapterId, orderIndex])
  @@index([type])
  @@index([status])
  @@map("lessons")
}

/// Files attached to a lesson (PDFs, worksheets, slides, etc.).
/// Stored in the `lesson-resources` Supabase Storage bucket at path
/// `<lessonId>/<resourceId>`. Original filename + mime type live in
/// the row so signed-download URLs can serve the correct attachment.
model LessonResource {
  id        String   @id @default(uuid())
  lessonId  String   @map("lesson_id")
  name      String // Original filename, e.g. "workbook.pdf"
  path      String // Bucket-relative path, e.g. "<lessonId>/<resourceId>"
  size      Int // Bytes
  mimeType  String   @map("mime_type")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  lesson    Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  companyId String @default("00000000-0000-0000-0000-000000000001") @map("company_id")

  @@index([lessonId, createdAt])
  @@map("lesson_resources")
}

// ============================================
// QUIZ SYSTEM
// ============================================

model QuizQuestion {
  id           String       @id @default(uuid())
  lessonId     String       @map("lesson_id")
  questionText String       @map("question_text")
  type         QuestionType
  options      Json // ["Option A", "Option B", ...] or ["True", "False"]
  correctIndex Int          @map("correct_index") // Index of correct option
  explanation  String? // Shown after answering
  orderIndex   Int          @default(0) @map("order_index")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  // Relations
  lesson    Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  companyId String @default("00000000-0000-0000-0000-000000000001") @map("company_id")

  @@index([lessonId, orderIndex])
  @@map("quiz_questions")
}

model QuizAttempt {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  lessonId  String   @map("lesson_id")
  score     Int // Number correct
  total     Int // Total questions
  passed    Boolean  @default(false)
  answers   Json // { questionId: selectedIndex, ... }
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson    Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  companyId String @default("00000000-0000-0000-0000-000000000001") @map("company_id")

  @@index([userId, lessonId, createdAt])
  @@map("quiz_attempts")
}

// ============================================
// USER PROGRESS
// ============================================

model Enrollment {
  id              String           @id @default(uuid())
  userId          String           @map("user_id")
  courseId        String           @map("course_id")
  status          EnrollmentStatus @default(ACTIVE)
  source          EnrollmentSource @default(MANUAL)
  progressPercent Int              @default(0) @map("progress_percent") // Cached 0-100
  enrolledAt      DateTime         @default(now()) @map("enrolled_at")
  lastAccessedAt  DateTime?        @map("last_accessed_at")
  expiresAt       DateTime?        @map("expires_at")
  completedAt     DateTime?        @map("completed_at")
  revokedAt       DateTime?        @map("revoked_at")
  revokedReason   String?          @map("revoked_reason")

  // Relations
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course    Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  companyId String @default("00000000-0000-0000-0000-000000000001") @map("company_id")

  @@unique([userId, courseId])
  @@index([userId, status])
  @@index([courseId, status])
  @@index([expiresAt])
  @@map("enrollments")
}

model LessonProgress {
  id              String    @id @default(uuid())
  userId          String    @map("user_id")
  lessonId        String    @map("lesson_id")
  completed       Boolean   @default(false)
  completedAt     DateTime? @map("completed_at")
  watchedPercent  Int       @default(0) @map("watched_percent") // 0-100
  lastPositionSec Int       @default(0) @map("last_position_sec") // Resume position
  watchCount      Int       @default(0) @map("watch_count")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  // Relations
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson    Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  companyId String @default("00000000-0000-0000-0000-000000000001") @map("company_id")

  @@unique([userId, lessonId])
  @@index([userId, completed])
  @@map("lesson_progress")
}

// ============================================
// CERTIFICATES
// ============================================

/// One row per (user, module) once the member has completed every
/// lesson in that module. The presence of a row IS the eligibility
/// signal — the PDF itself is rendered lazily on first download and
/// cached in the `course-certificates` Storage bucket under the
/// issuance id. shortCode is the public-facing identifier shown on
/// the PDF (random base32, retried on collision).
model CertificateIssuance {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  moduleId  String   @map("module_id")
  /// Denormalised so listing a member's certificates can join straight
  /// to the course without traversing module → course.
  courseId  String   @map("course_id")
  shortCode String   @unique @map("short_code")
  issuedAt  DateTime @default(now()) @map("issued_at")
  createdAt DateTime @default(now()) @map("created_at")

  /// Admin who bypassed the module-completion gate to hand-issue this
  /// certificate. Null for auto-issued rows (the default path).
  manuallyIssuedById String? @map("manually_issued_by_id")

  /// Revocation trio. Set together by an admin action; presence of
  /// revokedAt is the "is revoked" signal. Member-side list + download
  /// filter these out; the auto-issue hook also treats a revoked row
  /// as "already handled" so a re-completion doesn't silently re-issue.
  revokedAt     DateTime? @map("revoked_at")
  revokedById   String?   @map("revoked_by_id")
  revokedReason String?   @map("revoked_reason")

  user             User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  module           Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  course           Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  manuallyIssuedBy User?  @relation("CertsManuallyIssued", fields: [manuallyIssuedById], references: [id], onDelete: SetNull)
  revokedBy        User?  @relation("CertsRevoked", fields: [revokedById], references: [id], onDelete: SetNull)
  companyId        String @default("00000000-0000-0000-0000-000000000001") @map("company_id")

  @@unique([userId, moduleId])
  @@index([userId, issuedAt])
  @@index([courseId])
  @@index([revokedAt])
  @@map("certificate_issuances")
}

// ============================================
// NUDGES
// ============================================

/// Admin-authored re-engagement message aimed at a specific member.
/// Delivered as a Resend email at create time AND rendered as a
/// dismissible banner on the member's next dashboard visit. Dismissal
/// stamps dismissedAt so the banner disappears; the row itself
/// persists as an audit trail (admin can see "was this nudge shown").
model Nudge {
  id          String    @id @default(uuid())
  userId      String    @map("user_id")
  /// Optional target course — if set, the email + banner CTAs deep-
  /// link there ("Resume <course>"). Null means a generic nudge back
  /// to the dashboard.
  courseId    String?   @map("course_id")
  message     String
  createdById String    @map("created_by_id")
  createdAt   DateTime  @default(now()) @map("created_at")
  /// Populated when Resend confirms the send. Null = email queue
  /// failed; the banner still shows so the nudge isn't wasted.
  emailSentAt DateTime? @map("email_sent_at")
  /// Set when the member clicks Dismiss on the banner. Also cleared
  /// implicitly when the member finishes the target course.
  dismissedAt DateTime? @map("dismissed_at")

  user      User    @relation("NudgeRecipient", fields: [userId], references: [id], onDelete: Cascade)
  course    Course? @relation(fields: [courseId], references: [id], onDelete: SetNull)
  createdBy User    @relation("NudgeAuthor", fields: [createdById], references: [id], onDelete: Restrict)
  companyId String  @default("00000000-0000-0000-0000-000000000001") @map("company_id")

  @@index([userId, dismissedAt])
  @@index([createdAt])
  @@map("nudges")
}

// ============================================
// LESSON NOTES
// ============================================

model Note {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  lessonId  String   @map("lesson_id")
  content   String   @default("")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson    Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  companyId String @default("00000000-0000-0000-0000-000000000001") @map("company_id")

  @@unique([userId, lessonId])
  @@map("notes")
}

// ============================================
// ANNOUNCEMENTS
// ============================================

model Announcement {
  id          String               @id @default(uuid())
  title       String
  body        String
  status      AnnouncementStatus   @default(DRAFT)
  category    AnnouncementCategory @default(GENERAL)
  publishedAt DateTime?            @map("published_at")
  /**
   * When set, a cron flips status to PUBLISHED at or after this
   * time. Cleared when the row is actually published.
   */
  scheduledAt DateTime?            @map("scheduled_at")
  /**
   * Hidden from the member feed once set. Reads-analytics rows
   * stay around — the row itself is preserved.
   */
  archivedAt  DateTime?            @map("archived_at")
  /**
   * Sticky pin keeps this row above un-pinned rows in both the
   * member feed and the admin list, regardless of publishedAt.
   */
  pinned      Boolean              @default(false)
  createdAt   DateTime             @default(now()) @map("created_at")
  updatedAt   DateTime             @updatedAt @map("updated_at")
  deletedAt   DateTime?            @map("deleted_at")
  // Author. Nullable + onDelete: SetNull so deleting an admin
  // doesn't cascade away every announcement they wrote.
  createdBy   String?              @map("created_by")

  // Relations
  reads         AnnouncementRead[]
  comments      AnnouncementComment[]
  reactions     AnnouncementReaction[]
  auditLogs     AnnouncementAuditLog[]
  createdByUser User?                  @relation("AnnouncementAuthor", fields: [createdBy], references: [id], onDelete: SetNull)
  companyId     String                 @default("00000000-0000-0000-0000-000000000001") @map("company_id")

  @@index([status])
  @@index([deletedAt])
  @@index([createdBy])
  @@index([archivedAt])
  @@index([scheduledAt])
  @@index([pinned])
  @@map("announcements")
}

model AnnouncementRead {
  id             String   @id @default(uuid())
  userId         String   @map("user_id")
  announcementId String   @map("announcement_id")
  readAt         DateTime @default(now()) @map("read_at")

  // Relations
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  companyId    String       @default("00000000-0000-0000-0000-000000000001") @map("company_id")

  @@unique([userId, announcementId])
  @@index([userId])
  @@map("announcement_reads")
}

model AnnouncementComment {
  id             String    @id @default(uuid())
  announcementId String    @map("announcement_id")
  userId         String    @map("user_id")
  body           String
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  /**
   * Soft delete so admins can audit who deleted what.
   */
  deletedAt      DateTime? @map("deleted_at")

  // Relations
  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId    String       @default("00000000-0000-0000-0000-000000000001") @map("company_id")

  @@index([announcementId, createdAt])
  @@index([userId])
  @@index([deletedAt])
  @@map("announcement_comments")
}

model AnnouncementReaction {
  id             String   @id @default(uuid())
  announcementId String   @map("announcement_id")
  userId         String   @map("user_id")
  /**
   * Emoji literal, e.g. "👍". One emoji per row, multiple rows per
   * user allowed (you can react with multiple emojis), but each
   * (announcement, user, emoji) triple is unique so the same user
   * can't double-react with the same emoji.
   */
  emoji          String
  createdAt      DateTime @default(now()) @map("created_at")

  // Relations
  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId    String       @default("00000000-0000-0000-0000-000000000001") @map("company_id")

  @@unique([announcementId, userId, emoji])
  @@index([announcementId])
  @@index([userId])
  @@map("announcement_reactions")
}

model AnnouncementAuditLog {
  id             String                  @id @default(uuid())
  announcementId String                  @map("announcement_id")
  /**
   * Actor. Nullable + SetNull so deleting an admin doesn't wipe
   * the audit trail.
   */
  userId         String?                 @map("user_id")
  action         AnnouncementAuditAction
  /**
   * Optional payload — e.g. the diff or a snapshot of what changed.
   * Stored as JSON so future actions can attach richer context
   * without a schema migration.
   */
  metadata       Json?
  createdAt      DateTime                @default(now()) @map("created_at")

  // Relations
  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  companyId    String       @default("00000000-0000-0000-0000-000000000001") @map("company_id")

  @@index([announcementId, createdAt])
  @@index([userId])
  @@map("announcement_audit_logs")
}

/**
 * Fixed-window per-IP rate limit counter. Each row tracks the number
 * of times a given IP hit a given action within a specific window
 * (window_start = floor(now / window_seconds) * window_seconds).
 * Caller composes the key + window size; this table only stores the
 * counter. Old rows are not auto-deleted — a periodic cron should
 * prune entries where window_start < now() - 1 day.
 * Primary use: brute-force protection on auth flows (sign-in, sign-
 * up, password reset, onboarding password-set).
 */
model RateLimit {
  id          String   @id @default(uuid())
  /**
   * The originating IP. From x-forwarded-for header on Vercel.
   */
  ip          String
  /**
   * Action key — e.g. "auth:sign-in", "auth:reset-password".
   */
  action      String
  /**
   * UTC start of the bucket window this row counts requests in.
   */
  windowStart DateTime @map("window_start")
  count       Int      @default(1)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([ip, action, windowStart])
  @@index([windowStart])
  @@map("rate_limits")
}

// ============================================
// INTERNAL — EMPLOYEE ONBOARDING
// ============================================

/// Internal HR record for a hire (contractor or staff). Distinct from
/// `User` because most people we onboard never touch the SaaS login —
/// only a small subset (the admin + internal team who use this tool)
/// also have a User row. When they do, `userId` links the two so we
/// can dedupe by identity later.
model Employee {
  id              String           @id @default(uuid())
  /// Optional link to the SaaS user account, if this hire also uses
  /// the platform. SetNull keeps the HR record intact if the User is
  /// ever deleted.
  userId          String?          @unique @map("user_id")
  name            String
  /// Free-text job title from the sheet ("SaaS Developer", "Video
  /// Editor", etc). Not an enum — the org keeps inventing new roles.
  roleTitle       String           @map("role_title")
  status          EmploymentStatus @default(ACTIVE)
  /// Day the hire signed / was formally onboarded.
  onboardingDate  DateTime?        @map("onboarding_date")
  /// Day they actually began work. Often days/weeks after onboarding.
  dateStarted     DateTime?        @map("date_started")
  /// Set together with `status = OFFBOARDED`.
  offboardingDate DateTime?        @map("offboarding_date")
  /// Free-text notes from HR (why they left, gotchas, etc).
  notes           String?
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  user                User?                         @relation("EmployeeUser", fields: [userId], references: [id], onDelete: SetNull)
  checklistStatuses   EmployeeChecklistItemStatus[]
  orgAssignments      OrgNode[]                     @relation("OrgNodeEmployee")
  positionAssignments PositionAssignment[]          @relation("EmployeePositionAssignments")
  statMetricsAssigned StatMetric[]                  @relation("StatMetricAssignee")
  companyId           String                        @default("00000000-0000-0000-0000-000000000001") @map("company_id")

  @@index([status])
  @@index([roleTitle])
  @@index([onboardingDate])
  @@map("employees")
}

/// One row per task in the (single, global) onboarding checklist.
/// Order matters for display and is preserved via `orderIndex`
/// (0-based, unique across all rows). Every Employee is
/// implicitly attached to the same list — the multi-template
/// abstraction that used to live here was cut in favour of a flat
/// model. Statuses reference items directly.
model OnboardingChecklistItem {
  id          String   @id @default(uuid())
  label       String
  description String?
  /// Display order across the whole checklist (0-based, unique).
  orderIndex  Int      @unique @map("order_index")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  statuses EmployeeChecklistItemStatus[]

  companyId String @default("00000000-0000-0000-0000-000000000001") @map("company_id")

  @@map("onboarding_checklist_items")
}

/// The per-employee state for a single checklist item. Absent row =
/// same as "no status yet"; the UI treats missing rows as NA so we
/// only write rows once an admin actually touches an item. `note` is
/// optional free-text (e.g. "waiting on IT for Gdrive access").
model EmployeeChecklistItemStatus {
  id          String              @id @default(uuid())
  employeeId  String              @map("employee_id")
  itemId      String              @map("item_id")
  status      ChecklistItemStatus @default(PENDING)
  note        String?
  completedAt DateTime?           @map("completed_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")

  employee  Employee                @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  item      OnboardingChecklistItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  companyId String                  @default("00000000-0000-0000-0000-000000000001") @map("company_id")

  @@unique([employeeId, itemId])
  @@index([employeeId])
  @@index([itemId])
  @@index([status])
  @@map("employee_checklist_item_statuses")
}

// ============================================
// INTERNAL — ORG BOARD (Hubbard 7-division)
// ============================================

/// A named snapshot of the whole org structure. Exactly one row
/// should carry `isCurrent = true` at any moment — the live board
/// admins see and edit. Older revisions are read-only history so
/// admins can compare "who was where in Q2 vs Q3". The service
/// layer enforces "one current" via transaction; callers should
/// still treat multiple currents as "any is fine" defensively.
model OrgBoardRevision {
  id          String    @id @default(uuid())
  name        String
  description String?
  isCurrent   Boolean   @default(false) @map("is_current")
  publishedAt DateTime? @map("published_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  createdById String?   @map("created_by_id")
  createdBy   User?     @relation("OrgBoardRevisionAuthor", fields: [createdById], references: [id], onDelete: SetNull)

  nodes     OrgNode[]
  auditLogs OrgNodeAuditLog[]
  companyId String            @default("00000000-0000-0000-0000-000000000001") @map("company_id")

  @@index([isCurrent])
  @@map("org_board_revisions")
}

/// One node in an org-board tree. Everything from the Founder box
/// down to a single position lives here — `kind` disambiguates
/// rendering. Trees are per-revision (revisionId), and moving a
/// node just changes its parentId. Cascade on parent delete so
/// removing a division cleanly wipes its descendants.
model OrgNode {
  id               String      @id @default(uuid())
  revisionId       String      @map("revision_id")
  parentId         String?     @map("parent_id")
  kind             OrgNodeKind
  /// Header text shown on the card (e.g. "Division 2 - Sales &
  /// Marketing" or "Founder" or "Recognition - Department 1").
  label            String
  /// Optional Hubbard-style dept number 1-21. Kept as a plain int
  /// so custom departments outside the classic 21 are still
  /// representable.
  deptNumber       Int?        @map("dept_number")
  /// The role/title displayed under the label — e.g. "Sales &
  /// Marketing Director" or "Video Editor". Used for POSITION
  /// nodes and for any header node that has a designated role.
  positionTitle    String?     @map("position_title")
  /// The Employee currently holding this node's role. Only
  /// meaningful for POSITION and DIVISION/DEPARTMENT-level roles.
  /// SetNull so offboarding an employee blanks the seat without
  /// destroying the org structure.
  employeeId       String?     @map("employee_id")
  /// Free-text fallback for people who aren't (yet) Employees.
  /// Handy for "To be hired" placeholders. Ignored when
  /// `employeeId` is set.
  freeTextHolder   String?     @map("free_text_holder")
  /// Free-text description of what this node/role does. Applies at
  /// any level (a Division has a Function; a Position has one too).
  functionText     String?     @map("function_text")
  /// Bullet list of the node's responsibilities. Stored as a
  /// Postgres text[] so we don't have to marshal JSON on the client.
  responsibilities String[]    @default([])
  /// Free-text notes (admin-only).
  notes            String?
  /// Optional Tailwind-safe colour token override. Divisions have
  /// a default palette so this can stay null for the common case.
  color            String?
  /// Sibling order within the same parent. Zero-based; unique
  /// only within (revisionId, parentId).
  orderIndex       Int         @map("order_index")
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")

  revision       OrgBoardRevision     @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  parent         OrgNode?             @relation("OrgNodeParent", fields: [parentId], references: [id], onDelete: Cascade)
  children       OrgNode[]            @relation("OrgNodeParent")
  employee       Employee?            @relation("OrgNodeEmployee", fields: [employeeId], references: [id], onDelete: SetNull)
  positionDetail PositionDetail?
  assignments    PositionAssignment[]
  auditLogs      OrgNodeAuditLog[]
  companyId      String               @default("00000000-0000-0000-0000-000000000001") @map("company_id")

  @@index([revisionId])
  @@index([parentId])
  @@index([kind])
  @@index([employeeId])
  @@map("org_nodes")
}

/// Position-specific attributes kept in a sidecar table so the main
/// tree stays lean. 1:1 with OrgNode; only rows of kind POSITION or
/// DIVISION/DEPARTMENT that have a formal role head will have one.
/// Missing PositionDetail means "no structured detail yet" — the
/// admin can add later.
model PositionDetail {
  id             String          @id @default(uuid())
  nodeId         String          @unique @map("node_id")
  /// Human-readable identifier (e.g. "POS-004" or "ENG-DIR"). No
  /// uniqueness constraint at the DB layer — organisations sometimes
  /// reuse codes across divisions on purpose.
  code           String?
  /// Numeric seniority. Convention: 1 = executive, 10 = individual
  /// contributor. Nullable because plenty of positions don't slot
  /// neatly onto a linear ladder.
  level          Int?
  /// Headcount range for this seat. Both nullable because most
  /// positions have exactly one holder — the fields matter when a
  /// role is scaled (e.g. "3-5 Appointment Setters in this unit").
  headcountMin   Int?            @map("headcount_min")
  headcountMax   Int?            @map("headcount_max")
  employmentType EmploymentType? @map("employment_type")
  /// Position-specific KPIs.
  kpis           String[]        @default([])
  /// Position-specific qualifications.
  requirements   String[]        @default([])
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  node      OrgNode @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  companyId String  @default("00000000-0000-0000-0000-000000000001") @map("company_id")

  @@index([code])
  @@map("position_details")
}

/// Records an employee holding a position. Multiple rows per node
/// support the "multiple Video Editors" pattern from the Makh org
/// board. An assignment ends when `endedAt` is set; querying "who
/// currently holds this seat" filters `endedAt = null`.
model PositionAssignment {
  id             String          @id @default(uuid())
  nodeId         String          @map("node_id")
  employeeId     String          @map("employee_id")
  dateAssigned   DateTime        @default(now()) @map("date_assigned")
  endedAt        DateTime?       @map("ended_at")
  employmentType EmploymentType? @map("employment_type")
  notes          String?
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  node      OrgNode  @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  employee  Employee @relation("EmployeePositionAssignments", fields: [employeeId], references: [id], onDelete: Cascade)
  companyId String   @default("00000000-0000-0000-0000-000000000001") @map("company_id")

  @@index([nodeId, endedAt])
  @@index([employeeId, endedAt])
  @@map("position_assignments")
}

/// Append-only log of every mutation on the org board. `nodeId` is
/// nullable + SetNull so history survives after a node is deleted
/// (we still want to know "someone deleted Department X on this
/// date"). `oldValue` / `newValue` are free-form JSON so we can
/// stash whatever the mutation touched without a migration when the
/// service layer gains a new field.
model OrgNodeAuditLog {
  id          String         @id @default(uuid())
  revisionId  String         @map("revision_id")
  /// The node the change targeted. Null for post-deletion history.
  nodeId      String?        @map("node_id")
  /// User who initiated the change. Null when the change came from
  /// a service token or a background job.
  actorUserId String?        @map("actor_user_id")
  action      OrgAuditAction
  /// Freeze of the affected fields *before* the change (null for
  /// creates). Compact — we don't snapshot the whole node.
  oldValue    Json?
  /// Freeze of the affected fields *after* the change (null for
  /// pure deletes).
  newValue    Json?
  createdAt   DateTime       @default(now()) @map("created_at")

  revision  OrgBoardRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  node      OrgNode?         @relation(fields: [nodeId], references: [id], onDelete: SetNull)
  actor     User?            @relation("OrgAuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  companyId String           @default("00000000-0000-0000-0000-000000000001") @map("company_id")

  @@index([revisionId, createdAt])
  @@index([nodeId, createdAt])
  @@map("org_node_audit_logs")
}

// ============================================
// STATISTICS TRACKER
// ============================================

/// Unit of measurement stamped on a metric — informs how values are
/// formatted in the UI (e.g. "$1,234" vs "1,234" vs "82%"). Kept
/// small on purpose; edge cases can render raw counts.
enum StatMetricUnit {
  COUNT
  CURRENCY
  PERCENT
}

/// Divisions are the top-level grouping in the Hubbard-style stats
/// board (HCO, Marketing, Treasury, etc.). Admin-configurable so
/// each team can shape the taxonomy without a code change.
model StatDivision {
  id          String    @id @default(uuid())
  name        String
  /// Optional short label ("Div 1", "2A") shown above the name in
  /// tabs. Null falls back to a numeric position.
  shortLabel  String?   @map("short_label")
  description String?
  orderIndex  Int       @default(0) @map("order_index")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  metrics   StatMetric[]
  companyId String       @default("00000000-0000-0000-0000-000000000001") @map("company_id")

  @@index([orderIndex])
  @@index([deletedAt])
  @@map("stat_divisions")
}

/// A single metric card — one KPI tracked over time. Belongs to a
/// division and (optionally) has an assigned owner. The assigned
/// user + admins can add data points; everyone with admin/stat
/// access can view.
model StatMetric {
  id           String         @id @default(uuid())
  divisionId   String         @map("division_id")
  name         String
  description  String?
  unit         StatMetricUnit @default(COUNT)
  /// User accountable for the metric. Null = unassigned (still
  /// admin-editable). SetNull on user delete so history survives.
  assignedToId String?        @map("assigned_to_id")
  orderIndex   Int            @default(0) @map("order_index")
  /// Optional target value drawn as a horizontal reference line on
  /// the chart. Nullable — a lot of stats don't have hard targets.
  targetValue  Decimal?       @map("target_value") @db.Decimal(18, 4)
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")
  deletedAt    DateTime?      @map("deleted_at")

  division   StatDivision    @relation(fields: [divisionId], references: [id], onDelete: Cascade)
  assignedTo Employee?       @relation("StatMetricAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  dataPoints StatDataPoint[]
  companyId  String          @default("00000000-0000-0000-0000-000000000001") @map("company_id")

  @@index([divisionId, orderIndex])
  @@index([assignedToId])
  @@index([deletedAt])
  @@map("stat_metrics")
}

/// One recorded value on a metric's time-series. recordedAt stores
/// the point-in-time this value represents (typically the end of a
/// week). (metricId, recordedAt) is unique so a per-week grain never
/// double-records — updating an existing week goes through upsert.
model StatDataPoint {
  id          String   @id @default(uuid())
  metricId    String   @map("metric_id")
  value       Decimal  @db.Decimal(18, 4)
  recordedAt  DateTime @map("recorded_at") @db.Date
  note        String?
  createdById String?  @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  metric    StatMetric @relation(fields: [metricId], references: [id], onDelete: Cascade)
  createdBy User?      @relation("StatDataPointAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  companyId String     @default("00000000-0000-0000-0000-000000000001") @map("company_id")

  @@unique([metricId, recordedAt])
  @@index([metricId, recordedAt])
  @@map("stat_data_points")
}

// ============================================
// INTERNAL TASK TRACKER  (Phase 1)
// ============================================
//
// A tenant-scoped Trello/Linear-style task tracker for internal team
// use. Twelve models here; all live under the same `companyId`
// column pattern as the rest of the app and are added to the Prisma
// tenancy extension SCOPED_MODELS set so scoping fires automatically.
//
// Priorities are a small closed set — modeled as an enum. Statuses
// are per-tenant configurable rows on `task_statuses` so admins can
// rename / reorder / recolor them and add new workflow stages later.
// Labels + categories are the same pattern: per-tenant admin-editable.
//
// Deliberate omissions in Phase 1:
//   - No `TaskProject` / `TaskSprint` / `TaskMilestone` yet. `Task`
//     carries `parentTaskId` so subtask + related-task graphs work
//     right now, and projects can slot in later as an additional
//     grouping without touching this schema much.
//   - No time-tracking log (session start/stop). `estimatedHours` +
//     `actualHours` on Task cover the coarse case for now.

/// Discrete priority levels. Kept as an enum because the set is
/// small, universal across tenants, and we want compact indexes on
/// it. Ordering is meaningful — CRITICAL > HIGH > MEDIUM > LOW —
/// used by list-view default sort.
enum TaskPriority {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

/// Admin-editable workflow stage. Every task carries `statusId`
/// pointing at a row here. Defaults are seeded on first task-tracker
/// render per tenant (see lib/services/task-workflow-service.ts).
///
/// `isTerminal` marks "done"-ish stages so counters + filters can
/// distinguish "in flight" from "closed" without hard-coding names.
/// `isDefault` is the target for freshly-created tasks — exactly one
/// row per tenant should have it, enforced app-side.
model TaskStatus {
  id         String   @id @default(uuid())
  name       String
  /// URL-safe handle — used in filter query strings + saved views so
  /// links survive a rename. Unique per tenant.
  slug       String
  /// Tailwind-safe hex used for the Kanban column bar + status pill.
  color      String   @default("#94a3b8")
  orderIndex Int      @default(0) @map("order_index")
  isDefault  Boolean  @default(false) @map("is_default")
  isTerminal Boolean  @default(false) @map("is_terminal")
  /// Optional soft WIP limit for Kanban columns. Null = no limit.
  wipLimit   Int?     @map("wip_limit")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  tasks     Task[]
  companyId String @default("00000000-0000-0000-0000-000000000001") @map("company_id")

  @@unique([companyId, slug])
  @@index([companyId, orderIndex])
  @@map("task_statuses")
}

/// Admin-editable category (Bug / Feature / Ops / etc.). Optional on
/// a task — used for filtering + grouping.
model TaskCategory {
  id        String   @id @default(uuid())
  name      String
  color     String   @default("#94a3b8")
  createdAt DateTime @default(now()) @map("created_at")

  tasks     Task[]
  companyId String @default("00000000-0000-0000-0000-000000000001") @map("company_id")

  @@unique([companyId, name])
  @@map("task_categories")
}

/// Free-form label / tag. Many-to-many with tasks via TaskLabelLink.
/// Distinct from Category because a task typically carries one
/// category but many labels ("backend" + "api" + "urgent").
model TaskLabel {
  id        String   @id @default(uuid())
  name      String
  color     String   @default("#94a3b8")
  createdAt DateTime @default(now()) @map("created_at")

  links     TaskLabelLink[]
  companyId String          @default("00000000-0000-0000-0000-000000000001") @map("company_id")

  @@unique([companyId, name])
  @@map("task_labels")
}

/// The central row. Everything else (comments, checklists, etc.)
/// hangs off this via cascade-delete so a task-level delete cleans up
/// the whole tree. Soft-deleted rows keep `deletedAt` set so an
/// "Archive" can be un-done from the row action.
model Task {
  id          String       @id @default(uuid())
  title       String
  /// Rich-text body. Plain text through Phase 4; Tiptap upgrade in
  /// Phase 5. Nullable because a task can be created title-only.
  description String?      @db.Text
  statusId    String       @map("status_id")
  priority    TaskPriority @default(MEDIUM)
  categoryId  String?      @map("category_id")

  /// Who created / owns follow-up on this task. Required — a task
  /// without a reporter is orphan work. SetNull on user delete so
  /// we don't lose the task itself; the row just shows "System" as
  /// the reporter.
  reporterId String? @map("reporter_id")

  /// Self-referential parent for subtasks + related-task graphs.
  /// SetNull rather than Cascade so deleting a parent doesn't wipe
  /// out its subtasks — a common accidental foot-gun.
  parentTaskId String? @map("parent_task_id")

  /// Marks the task as a recurring template. On transition to a
  /// terminal status the service clones a fresh copy (also flagged
  /// recurring) into the first non-terminal status so the next
  /// instance is ready without any manual work.
  isRecurring Boolean @default(false) @map("is_recurring")

  startDate      DateTime? @map("start_date") @db.Date
  dueDate        DateTime? @map("due_date") @db.Date
  estimatedHours Decimal?  @map("estimated_hours") @db.Decimal(8, 2)
  actualHours    Decimal?  @map("actual_hours") @db.Decimal(8, 2)

  /// Kanban ordering within a status column. Cards are ordered by
  /// this ascending; drag-drop rewrites it. Keep gaps (100, 200, 300)
  /// so single-card moves rarely need to touch neighbours.
  orderIndex Int @default(0) @map("order_index")

  archivedAt DateTime? @map("archived_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")

  status     TaskStatus    @relation(fields: [statusId], references: [id], onDelete: Restrict)
  category   TaskCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  reporter   User?         @relation("TaskReporter", fields: [reporterId], references: [id], onDelete: SetNull)
  parentTask Task?         @relation("TaskParent", fields: [parentTaskId], references: [id], onDelete: SetNull)
  subtasks   Task[]        @relation("TaskParent")

  assignees     TaskAssignee[]
  watchers      TaskWatcher[]
  labels        TaskLabelLink[]
  comments      TaskComment[]
  checklists    TaskChecklist[]
  attachments   TaskAttachment[]
  activityLogs  TaskActivityLog[]
  notifications TaskNotification[]

  companyId String @default("00000000-0000-0000-0000-000000000001") @map("company_id")

  @@index([companyId, statusId, orderIndex])
  @@index([companyId, priority])
  @@index([companyId, dueDate])
  @@index([companyId, categoryId])
  @@index([companyId, reporterId])
  @@index([companyId, archivedAt])
  @@index([companyId, deletedAt])
  @@map("tasks")
}

/// Junction table for the many-to-many between Task and TaskLabel.
/// Both sides cascade — the join disappears if either side is
/// deleted, no orphan links.
model TaskLabelLink {
  taskId    String   @map("task_id")
  labelId   String   @map("label_id")
  createdAt DateTime @default(now()) @map("created_at")

  task      Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  label     TaskLabel @relation(fields: [labelId], references: [id], onDelete: Cascade)
  companyId String    @default("00000000-0000-0000-0000-000000000001") @map("company_id")

  @@id([taskId, labelId])
  @@index([companyId])
  @@map("task_label_links")
}

/// A user assigned to a task. Multi-assignee by design — Linear-
/// style single-assignee is achievable at the UI layer while keeping
/// the schema flexible for team-based tasks.
model TaskAssignee {
  taskId    String   @map("task_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  task      Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId String @default("00000000-0000-0000-0000-000000000001") @map("company_id")

  @@id([taskId, userId])
  @@index([companyId, userId])
  @@map("task_assignees")
}

/// A user watching a task — receives notifications on state changes
/// + comments even when not assigned. Auto-added on comment/mention;
/// admins can add / remove others.
model TaskWatcher {
  taskId    String   @map("task_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  task      Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId String @default("00000000-0000-0000-0000-000000000001") @map("company_id")

  @@id([taskId, userId])
  @@index([companyId, userId])
  @@map("task_watchers")
}

/// A single comment on a task. Body is plain text through Phase 4;
/// Tiptap HTML from Phase 5 onwards. Edits set `editedAt` + record
/// the editor separately (usually the same as author).
model TaskComment {
  id         String    @id @default(uuid())
  taskId     String    @map("task_id")
  authorId   String?   @map("author_id")
  body       String    @db.Text
  editedAt   DateTime? @map("edited_at")
  editedById String?   @map("edited_by_id")
  createdAt  DateTime  @default(now()) @map("created_at")

  task      Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author    User?  @relation(fields: [authorId], references: [id], onDelete: SetNull)
  editedBy  User?  @relation("TaskCommentEditor", fields: [editedById], references: [id], onDelete: SetNull)
  companyId String @default("00000000-0000-0000-0000-000000000001") @map("company_id")

  @@index([companyId, taskId, createdAt])
  @@map("task_comments")
}

/// A named checklist on a task. A task can hold multiple checklists
/// ("Pre-launch", "Handoff", etc.); each has ordered items.
model TaskChecklist {
  id         String   @id @default(uuid())
  taskId     String   @map("task_id")
  title      String
  orderIndex Int      @default(0) @map("order_index")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  task      Task                @relation(fields: [taskId], references: [id], onDelete: Cascade)
  items     TaskChecklistItem[]
  companyId String              @default("00000000-0000-0000-0000-000000000001") @map("company_id")

  @@index([companyId, taskId, orderIndex])
  @@map("task_checklists")
}

model TaskChecklistItem {
  id          String    @id @default(uuid())
  checklistId String    @map("checklist_id")
  text        String
  isDone      Boolean   @default(false) @map("is_done")
  doneById    String?   @map("done_by_id")
  doneAt      DateTime? @map("done_at")
  orderIndex  Int       @default(0) @map("order_index")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  checklist TaskChecklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  doneBy    User?         @relation("TaskChecklistDoneBy", fields: [doneById], references: [id], onDelete: SetNull)
  companyId String        @default("00000000-0000-0000-0000-000000000001") @map("company_id")

  @@index([companyId, checklistId, orderIndex])
  @@map("task_checklist_items")
}

/// File attached to a task. Bytes live in a Supabase Storage bucket
/// (`task-attachments/<companyId>/<taskId>/...`); this row is the
/// metadata pointer + audit surface.
model TaskAttachment {
  id           String   @id @default(uuid())
  taskId       String   @map("task_id")
  name         String
  path         String
  size         Int
  mimeType     String   @map("mime_type")
  uploadedById String?  @map("uploaded_by_id")
  /// External URL for "link" attachments (Google Drive, Frame.io,
  /// Figma, etc.). When set, path/size/mimeType are placeholder
  /// values (empty / 0 / "link/external") and the download flow
  /// opens sourceUrl in a new tab instead of signing a storage URL.
  sourceUrl    String?  @map("source_url")
  createdAt    DateTime @default(now()) @map("created_at")

  task       Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  uploadedBy User?  @relation("TaskAttachmentUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  companyId  String @default("00000000-0000-0000-0000-000000000001") @map("company_id")

  @@index([companyId, taskId, createdAt])
  @@map("task_attachments")
}

/// Immutable audit log of every state-changing event on a task —
/// created, status/priority/assignee changed, comment added,
/// checklist toggled, archived, restored, etc. Powers the detail
/// drawer's activity timeline and future automation triggers.
model TaskActivityLog {
  id        String   @id @default(uuid())
  taskId    String   @map("task_id")
  actorId   String?  @map("actor_id")
  /// Short verb tag: "created", "status_changed", "assigned", etc.
  /// Consumers switch on this to render the right sentence.
  action    String
  /// Prior value snapshot (JSON) for diff-style rendering. Nullable
  /// because a "created" event has no prior state.
  fromValue Json?    @map("from_value")
  /// New value snapshot (JSON). Nullable for pure delete events.
  toValue   Json?    @map("to_value")
  createdAt DateTime @default(now()) @map("created_at")

  task      Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  actor     User?  @relation("TaskActivityActor", fields: [actorId], references: [id], onDelete: SetNull)
  companyId String @default("00000000-0000-0000-0000-000000000001") @map("company_id")

  @@index([companyId, taskId, createdAt])
  @@map("task_activity_logs")
}

/// In-app notification. One row per recipient per event — a
/// broadcast to N watchers becomes N rows so read state stays per
/// user. Tenant-scoped like the rest of the tracker; every
/// notification anchors to the task it fires for so cascade cleans
/// up when the task is hard-deleted.
model TaskNotification {
  id          String    @id @default(uuid())
  taskId      String    @map("task_id")
  recipientId String    @map("recipient_id")
  actorId     String?   @map("actor_id")
  /// Short verb tag, same catalog as TaskActivityLog.action so the
  /// notification renderer can reuse the activity sentence
  /// mappings. Kept as a plain String rather than an enum so
  /// adding a new event doesn't need a migration.
  kind        String
  /// Snapshot JSON (from/to values, comment excerpt, etc.) so the
  /// bell dropdown can render without a re-query.
  payload     Json?
  readAt      DateTime? @map("read_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  task      Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  recipient User   @relation("TaskNotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  actor     User?  @relation("TaskNotificationActor", fields: [actorId], references: [id], onDelete: SetNull)
  companyId String @default("00000000-0000-0000-0000-000000000001") @map("company_id")

  @@index([recipientId, readAt, createdAt])
  @@index([companyId, taskId])
  @@map("task_notifications")
}

// ============================================
// POLICIES
// ============================================
// Internal ops docs (Kondense's Makh-style "hat write-ups"). One
// Policy per role/process. Free-form rich-text body — each publish
// snapshots to PolicyRevision so admins can compare + roll back.
// Reuses TaskAttachment / TaskActivityLog conventions.

enum PolicyStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

/// Admin-editable category (Role Hats / Processes / Systems /
/// Onboarding). Optional on a policy — used for filtering + grouping.
model PolicyCategory {
  id        String   @id @default(uuid())
  name      String
  color     String   @default("#94a3b8")
  createdAt DateTime @default(now()) @map("created_at")

  policies  Policy[]
  companyId String   @default("00000000-0000-0000-0000-000000000001") @map("company_id")

  @@unique([companyId, name])
  @@map("policy_categories")
}

/// A durable reference doc — starts DRAFT, moves to PUBLISHED (which
/// also snapshots a PolicyRevision + bumps `revision`), can be
/// ARCHIVED to hide from active lists without losing history.
/// Soft-deleted rows keep `deletedAt` so an accidental delete can be
/// undone from row actions.
model Policy {
  id         String       @id @default(uuid())
  title      String
  /// Rich-text HTML from Tiptap. Nullable — a policy can be created
  /// title-only and filled in later.
  body       String?      @db.Text
  status     PolicyStatus @default(DRAFT)
  /// Incremented on each successful publish. Drafts sit at 0 until
  /// the first publish makes them Rev I. Current body always lives
  /// on this row; PolicyRevision holds frozen prior snapshots.
  revision   Int          @default(0)
  categoryId String?      @map("category_id")

  /// Author. SetNull so deleting an admin doesn't cascade away every
  /// policy they wrote.
  createdBy String? @map("created_by")
  /// Most-recent editor. SetNull for the same reason.
  updatedBy String? @map("updated_by")

  /// First-published timestamp. Once set, stays set — re-publishes
  /// update `revision` and snapshot to PolicyRevision but leave this
  /// pointing at the original go-live moment.
  publishedAt DateTime? @map("published_at")
  archivedAt  DateTime? @map("archived_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  category      PolicyCategory?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  createdByUser User?               @relation("PolicyAuthor", fields: [createdBy], references: [id], onDelete: SetNull)
  updatedByUser User?               @relation("PolicyEditor", fields: [updatedBy], references: [id], onDelete: SetNull)
  revisions     PolicyRevision[]
  attachments   PolicyAttachment[]
  activityLogs  PolicyActivityLog[]

  companyId String @default("00000000-0000-0000-0000-000000000001") @map("company_id")

  @@index([companyId, status])
  @@index([companyId, categoryId])
  @@index([companyId, publishedAt])
  @@index([companyId, archivedAt])
  @@index([companyId, deletedAt])
  @@map("policies")
}

/// Frozen snapshot at publish time. One row per publish; Rev I is
/// the first. `title` + `body` are copied so restoring a revision is
/// a straight copy back into the parent Policy.
model PolicyRevision {
  id            String   @id @default(uuid())
  policyId      String   @map("policy_id")
  revision      Int
  title         String
  body          String?  @db.Text
  publishedAt   DateTime @default(now()) @map("published_at")
  publishedById String?  @map("published_by_id")

  policy      Policy @relation(fields: [policyId], references: [id], onDelete: Cascade)
  publishedBy User?  @relation("PolicyRevisionPublisher", fields: [publishedById], references: [id], onDelete: SetNull)

  companyId String @default("00000000-0000-0000-0000-000000000001") @map("company_id")

  @@unique([policyId, revision])
  @@index([companyId, policyId, publishedAt])
  @@map("policy_revisions")
}

/// File + link attachments. Mirrors TaskAttachment — a row is either
/// a Supabase-Storage file (path/size/mimeType filled) or an external
/// link (sourceUrl set; other columns are placeholders).
model PolicyAttachment {
  id           String   @id @default(uuid())
  policyId     String   @map("policy_id")
  name         String
  path         String
  size         Int
  mimeType     String   @map("mime_type")
  uploadedById String?  @map("uploaded_by_id")
  sourceUrl    String?  @map("source_url")
  createdAt    DateTime @default(now()) @map("created_at")

  policy     Policy @relation(fields: [policyId], references: [id], onDelete: Cascade)
  uploadedBy User?  @relation("PolicyAttachmentUploader", fields: [uploadedById], references: [id], onDelete: SetNull)

  companyId String @default("00000000-0000-0000-0000-000000000001") @map("company_id")

  @@index([companyId, policyId, createdAt])
  @@map("policy_attachments")
}

/// Immutable audit log of every state-changing event on a policy —
/// created, published, archived, restored, revision reverted, etc.
/// Same shape + verbs catalog as TaskActivityLog.
model PolicyActivityLog {
  id        String   @id @default(uuid())
  policyId  String   @map("policy_id")
  actorId   String?  @map("actor_id")
  /// Short verb tag: "created", "published", "archived",
  /// "restored", "reverted_to_revision", "edited", etc.
  action    String
  fromValue Json?    @map("from_value")
  toValue   Json?    @map("to_value")
  createdAt DateTime @default(now()) @map("created_at")

  policy Policy @relation(fields: [policyId], references: [id], onDelete: Cascade)
  actor  User?  @relation("PolicyActivityActor", fields: [actorId], references: [id], onDelete: SetNull)

  companyId String @default("00000000-0000-0000-0000-000000000001") @map("company_id")

  @@index([companyId, policyId, createdAt])
  @@map("policy_activity_logs")
}

// ============================================
// TEAM MODULE ACCESS GRANTS
// ============================================
// Per-user access grants for Internal admin modules (Task Tracker,
// Policies, Statistics, etc.) when the target user is a TEAM member.
// ADMIN role always sees everything; MEMBER role never sees any of
// this. The gate check reads unrevoked, unexpired rows for (userId,
// moduleKey) in the current tenant.
//
// Append-only shape (mirrors SuperAdminGrant): a grant → revoke →
// re-grant cycle creates three rows so the timeline stays auditable.
// Only one row per (userId, moduleKey) with revokedAt IS NULL is
// legal at any given moment; enforced app-side by the service.

// ============================================
// CUSTOM ROLES (per-company)
// ============================================
//
// Configurable role catalog per company — replaces the fixed
// TeamModuleGrant grid with named permission bundles. Admins
// define roles (e.g. "Setter", "Closer", "Helper") and assign
// them to users; a user's effective module access is the union
// of every role they hold.
//
// Sits ON TOP of CompanyMembership.role (which stays as the tier
// enum: OWNER/ADMIN/TEAM/MEMBER). Admin tier still bypasses the
// permission check entirely; TEAM tier is what the roles gate.

/// One customisable role in a company. `isSystem` rows are seeded
/// by the migration (the built-in "Internal Team" role, plus any
/// per-user "Legacy" roles carried over from TeamModuleGrant) and
/// cannot be deleted — their name + description are still
/// editable so admins can rename them.
model Role {
  id          String   @id @default(uuid())
  companyId   String   @map("company_id")
  /// Display name shown in the picker and roles list.
  name        String
  /// URL-safe unique-per-company handle; used to look up seeded
  /// system roles (e.g. slug='internal-team') without name drift.
  slug        String
  description String?
  /// True for migration-seeded roles that must survive deletion
  /// (their assignments hold the only record of what a user could
  /// previously see). Name/description still editable.
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  permissions RolePermission[]
  assignments UserRoleAssignment[]

  @@unique([companyId, slug])
  @@index([companyId])
  @@map("roles")
}

/// One (role, module) grant. Same moduleKey values as
/// lib/config/team-modules.ts — deliberately a String, not an
/// enum, so adding a module doesn't need a migration.
model RolePermission {
  id        String @id @default(uuid())
  roleId    String @map("role_id")
  moduleKey String @map("module_key")
  companyId String @map("company_id")

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, moduleKey])
  @@index([companyId, moduleKey])
  @@map("role_permissions")
}

/// Assignment of a user to a role. Multi-role: a user can hold
/// several ("Setter" + "Closer" for someone who does both).
/// Effective permissions are the union.
model UserRoleAssignment {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  roleId       String   @map("role_id")
  companyId    String   @map("company_id")
  assignedAt   DateTime @default(now()) @map("assigned_at")
  assignedById String?  @map("assigned_by_id")

  user       User  @relation("UserRoleAssignmentTarget", fields: [userId], references: [id], onDelete: Cascade)
  role       Role  @relation(fields: [roleId], references: [id], onDelete: Cascade)
  assignedBy User? @relation("UserRoleAssignmentGrantedBy", fields: [assignedById], references: [id], onDelete: SetNull)

  @@unique([userId, roleId])
  @@index([companyId, userId])
  @@index([companyId, roleId])
  @@map("user_role_assignments")
}

// ============================================
// PRODUCTION SHEET
// ============================================
//
// Setter/closer daily production log. Modeled after the sales-team
// Google Sheet that inspired this module: each user records daily
// counts + notes; appointments they set (and closers who close
// them) each get an AppointmentSet row; monthly targets drive the
// "run rate" projection on the entry sheet.
//
// Team-private by design: each user only queries their own rows.
// ADMIN role bypasses via a user picker in the shell.

/// One row per (user, calendar day). Every metric column is
/// nullable so a fresh row can save with just a phone-calls number
/// and fill in the rest later. Monetary columns are Decimal for
/// exact currency math; counters are Int.
model ProductionEntry {
  id              String   @id @default(uuid())
  userId          String   @map("user_id")
  /// Calendar day the row belongs to. `@db.Date` strips the time
  /// component — the (user, day) unique index below relies on that
  /// so an afternoon edit doesn't create a second row.
  date            DateTime @db.Date
  phoneCalls      Int?     @map("phone_calls")
  dms             Int?
  cellConnects    Int?     @map("cell_connects")
  appointmentsSet Int?     @map("appointments_set")
  demosConducted  Int?     @map("demos_conducted")
  introUnits      Int?     @map("intro_units")
  basisUnits      Int?     @map("basis_units")
  majorUnits      Int?     @map("major_units")
  sales           Decimal? @db.Decimal(12, 2)
  collections     Decimal? @db.Decimal(12, 2)
  notes           String?
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId String @default("00000000-0000-0000-0000-000000000001") @map("company_id")

  @@unique([userId, date, companyId])
  @@index([companyId, userId, date])
  @@map("production_entries")
}

/// Monthly production targets per user. Drives the "Monthly
/// Targets / Remaining / Days Left / Run Rate" summary row at the
/// bottom of the daily-entry sheet.
model ProductionTarget {
  id              String   @id @default(uuid())
  userId          String   @map("user_id")
  /// (year, month) uniquely identifies a target block per user.
  /// month is 1..12 (not 0-indexed).
  year            Int
  month           Int
  phoneCalls      Int?     @map("phone_calls")
  dms             Int?
  cellConnects    Int?     @map("cell_connects")
  appointmentsSet Int?     @map("appointments_set")
  demosConducted  Int?     @map("demos_conducted")
  introUnits      Int?     @map("intro_units")
  basisUnits      Int?     @map("basis_units")
  majorUnits      Int?     @map("major_units")
  sales           Decimal? @db.Decimal(12, 2)
  collections     Decimal? @db.Decimal(12, 2)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId String @default("00000000-0000-0000-0000-000000000001") @map("company_id")

  @@unique([userId, year, month, companyId])
  @@index([companyId, userId, year, month])
  @@map("production_targets")
}

enum AppointmentStatus {
  PENDING
  SHOWED
  NO_SHOW
  CLOSED
  LOST
}

/// A prospect appointment: the setter who booked it + (once
/// assigned) the closer, plus the outcome. `setById` is required
/// (someone had to log the row); `closerId` is nullable while the
/// deal is still in flight.
model AppointmentSet {
  id               String            @id @default(uuid())
  setById          String            @map("set_by_id")
  closerId         String?           @map("closer_id")
  prospectName     String            @map("prospect_name")
  prospectPhone    String?           @map("prospect_phone")
  /// Day the appointment was created / logged.
  setAt            DateTime          @default(now()) @map("set_at") @db.Date
  /// Scheduled appointment date/time — may sit in the past once the
  /// call has happened.
  appointmentAt    DateTime?         @map("appointment_at")
  status           AppointmentStatus @default(PENDING)
  revenueCollected Decimal?          @map("revenue_collected") @db.Decimal(12, 2)
  immediateAmount  Decimal?          @map("immediate_amount") @db.Decimal(12, 2)
  monthlyPayment   Decimal?          @map("monthly_payment") @db.Decimal(12, 2)
  /// Free-form "funnel" flag from the original spreadsheet — "Y" /
  /// "N" indicating whether the prospect came through the paid
  /// funnel vs. an organic channel.
  funnel           Boolean?
  notes            String?
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")

  setBy  User  @relation("AppointmentSetSetter", fields: [setById], references: [id], onDelete: Cascade)
  closer User? @relation("AppointmentSetCloser", fields: [closerId], references: [id], onDelete: SetNull)

  companyId String @default("00000000-0000-0000-0000-000000000001") @map("company_id")

  @@index([companyId, setById, setAt])
  @@index([companyId, closerId, appointmentAt])
  @@index([companyId, status])
  @@map("appointment_sets")
}

// ============================================
// CRM — SALES PIPELINE  (P0 #1)
// ============================================
//
// The GoHighLevel-style pipeline. This is the evolution of the
// AppointmentSet proto-opportunity into a real Lead → Opportunity →
// Deal board. Structure deliberately mirrors the Task Tracker
// (CrmPipeline ≈ board, CrmPipelineStage ≈ TaskStatus, CrmOpportunity
// ≈ Task) so the Kanban + service + seeding conventions carry over.
//
// P0 keeps a contact as free-text fields on the opportunity; the
// crm_contact / crm_company models arrive in P0 #3 and will swap the
// text columns for FKs without touching the board.

/// Terminal-ish outcome of an opportunity. OPEN = still on the
/// board; WON/LOST are set when a card lands in a stage flagged
/// isWon / isLost (or via an explicit outcome action).
enum CrmOpportunityStatus {
  OPEN
  WON
  LOST
}

/// One sales pipeline (a Kanban board). A tenant can run several
/// (e.g. "New Business", "Renewals"); exactly one row should carry
/// isDefault, enforced app-side. Stages hang off this via cascade.
model CrmPipeline {
  id         String   @id @default(uuid())
  name       String
  /// URL-safe handle, unique per tenant — survives a rename in
  /// filter query strings + saved views.
  slug       String
  isDefault  Boolean  @default(false) @map("is_default")
  orderIndex Int      @default(0) @map("order_index")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  stages        CrmPipelineStage[]
  opportunities CrmOpportunity[]
  companyId     String             @default("00000000-0000-0000-0000-000000000001") @map("company_id")

  @@unique([companyId, slug])
  @@index([companyId, orderIndex])
  @@map("crm_pipelines")
}

/// A column on a pipeline. Mirrors TaskStatus. `isWon` / `isLost`
/// mark terminal columns so counters + reporting can split "in
/// flight" from "closed" without hard-coding names. `probability`
/// is the default win-likelihood a deal inherits when it lands here.
model CrmPipelineStage {
  id          String   @id @default(uuid())
  pipelineId  String   @map("pipeline_id")
  name        String
  slug        String
  /// Tailwind-safe hex for the column bar + stage pill.
  color       String   @default("#94a3b8")
  orderIndex  Int      @default(0) @map("order_index")
  /// Default win-probability (0–100) applied to deals in this stage.
  probability Int?
  isWon       Boolean  @default(false) @map("is_won")
  isLost      Boolean  @default(false) @map("is_lost")
  /// Optional soft WIP limit for the Kanban column. Null = no limit.
  wipLimit    Int?     @map("wip_limit")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  pipeline      CrmPipeline      @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  opportunities CrmOpportunity[]
  companyId     String           @default("00000000-0000-0000-0000-000000000001") @map("company_id")

  @@unique([pipelineId, slug])
  @@index([companyId, pipelineId, orderIndex])
  @@map("crm_pipeline_stages")
}

/// A deal on the board. Ordered within its stage by orderIndex
/// (gaps of 100 so single-card drags rarely touch neighbours) —
/// same scheme as Task. Stage FK is Restrict so a stage holding
/// deals can't be deleted out from under them.
model CrmOpportunity {
  id         String @id @default(uuid())
  name       String
  pipelineId String @map("pipeline_id")
  stageId    String @map("stage_id")

  /// Free-text contact/company for P0 — swapped for crm_contact /
  /// crm_company FKs in P0 #3.
  contactName  String? @map("contact_name")
  contactEmail String? @map("contact_email")
  contactPhone String? @map("contact_phone")
  companyName  String? @map("company_name")

  value             Decimal?  @db.Decimal(12, 2)
  probability       Int?
  expectedCloseDate DateTime? @map("expected_close_date") @db.Date

  /// The closer working the deal. SetNull so removing a user leaves
  /// the deal on the board unassigned rather than deleting history.
  assignedCloserId String? @map("assigned_closer_id")
  /// Who created the row. SetNull on user delete.
  createdById      String? @map("created_by_id")
  /// The contact (CrmLead) this deal hangs off — GHL model: every
  /// opportunity belongs to a contact, one contact can own many
  /// opportunities. Nullable while the P0 #3 backfill lands; the
  /// service layer's find-or-create makes new writes always fill it.
  contactId        String? @map("contact_id")

  status     CrmOpportunityStatus @default(OPEN)
  notes      String?              @db.Text
  /// Free-text lead source (e.g. "Facebook", "Referral"). Kept as a
  /// string rather than the CrmLeadSource enum so imported deals can
  /// carry whatever the source system labelled them.
  source     String?
  orderIndex Int                  @default(0) @map("order_index")

  wonAt      DateTime? @map("won_at")
  lostAt     DateTime? @map("lost_at")
  lostReason String?   @map("lost_reason")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  pipeline       CrmPipeline          @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  stage          CrmPipelineStage     @relation(fields: [stageId], references: [id], onDelete: Restrict)
  assignedCloser User?                @relation("CrmOpportunityCloser", fields: [assignedCloserId], references: [id], onDelete: SetNull)
  createdBy      User?                @relation("CrmOpportunityCreator", fields: [createdById], references: [id], onDelete: SetNull)
  contact        CrmLead?             @relation("CrmOpportunityContact", fields: [contactId], references: [id], onDelete: SetNull)
  // Leads that converted into this deal (usually 0 or 1) — the
  // legacy one-shot conversion pointer; distinct from `contact`
  // above, which is the persistent GHL-style link.
  sourceLeads    CrmLead[]            @relation("CrmLeadConversion")
  tasks          CrmOpportunityTask[]
  noteEntries    CrmOpportunityNote[]
  companyId      String               @default("00000000-0000-0000-0000-000000000001") @map("company_id")

  @@index([companyId, pipelineId, stageId, orderIndex])
  @@index([companyId, assignedCloserId])
  @@index([companyId, status])
  @@index([companyId, deletedAt])
  @@index([companyId, contactId])
  @@map("crm_opportunities")
}

// ----- CRM — opportunity activity (tasks + note timeline) -----
//
// Both models scope by companyId (tenant isolation) + opportunityId
// (the parent). Task/note rows die when the opportunity is deleted —
// there's no history worth preserving separately for a deleted deal.

/// A to-do item pinned to an opportunity. Assignee can differ from
/// creator (e.g. a manager filing a task for a rep to follow up).
/// completedAt=null means "still open"; setting it flips the row to
/// done and stamps the moment.
model CrmOpportunityTask {
  id            String @id @default(uuid())
  companyId     String @map("company_id")
  opportunityId String @map("opportunity_id")

  title       String
  dueDate     DateTime? @map("due_date") @db.Date
  completedAt DateTime? @map("completed_at")

  assigneeId  String? @map("assignee_id")
  createdById String? @map("created_by_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  opportunity CrmOpportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  assignee    User?          @relation("CrmOpportunityTaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdBy   User?          @relation("CrmOpportunityTaskCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([companyId, opportunityId, completedAt])
  @@index([companyId, assigneeId])
  @@map("crm_opportunity_tasks")
}

/// One entry in the opportunity's note timeline. Distinct from
/// CrmOpportunity.notes (a single free-text description field
/// preserved for CSV imports) — this table stores the multi-note
/// history shown in the Notes tab.
model CrmOpportunityNote {
  id            String @id @default(uuid())
  companyId     String @map("company_id")
  opportunityId String @map("opportunity_id")

  body     String  @db.Text
  authorId String? @map("author_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  opportunity CrmOpportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  author      User?          @relation("CrmOpportunityNoteAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([companyId, opportunityId, createdAt])
  @@map("crm_opportunity_notes")
}

// ============================================
// CRM — LEADS  (P0 #2)
// ============================================
//
// The top of the funnel: raw inbound people/companies before they're
// qualified. A lead carries its original source, an optional assigned
// setter, and a qualification status. On qualification it converts —
// for P0 that means spawning a CrmOpportunity directly (contact fields
// copy across as free text); P0 #3 inserts a crm_contact in between.

/// Where a lead originally came from. Stored from day one so later
/// source integrations (Facebook/Google Ads, webhooks, API) don't
/// need a schema change — they just set a different value.
enum CrmLeadSource {
  WEBSITE_FORM
  LANDING_PAGE
  FACEBOOK_ADS
  GOOGLE_ADS
  CSV_IMPORT
  MANUAL
  API
  WEBHOOK
  OTHER
}

/// Lead qualification lifecycle. NEW → CONTACTED → QUALIFIED (then
/// CONVERTED once a deal is spawned) or UNQUALIFIED (dead).
enum CrmLeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  UNQUALIFIED
  CONVERTED
}

model CrmLead {
  id             String  @id @default(uuid())
  fullName       String  @map("full_name")
  email          String?
  phone          String?
  secondaryPhone String? @map("secondary_phone")
  /// Prospect's company name (free text). Becomes a crm_company FK
  /// in a later phase.
  companyName    String? @map("company_name")
  address        String?

  source   CrmLeadSource @default(MANUAL)
  /// Free-text marketing campaign / ad-set label.
  campaign String?
  industry String?
  status   CrmLeadStatus @default(NEW)

  /// Setter the lead is routed to. SetNull so removing a user leaves
  /// the lead in the inbox, unassigned.
  assignedSetterId String? @map("assigned_setter_id")
  /// Operator who captured the row. SetNull on user delete.
  createdById      String? @map("created_by_id")

  notes          String?   @db.Text
  /// Last time any activity touched the lead — powers the "Last
  /// activity" column + stale-lead surfacing later.
  lastActivityAt DateTime? @map("last_activity_at")

  /// Set when the lead is converted; points at the spawned deal so
  /// the inbox can link straight to the pipeline card.
  convertedAt            DateTime? @map("converted_at")
  convertedOpportunityId String?   @map("converted_opportunity_id")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  assignedSetter       User?            @relation("CrmLeadSetter", fields: [assignedSetterId], references: [id], onDelete: SetNull)
  createdBy            User?            @relation("CrmLeadCreator", fields: [createdById], references: [id], onDelete: SetNull)
  convertedOpportunity CrmOpportunity?  @relation("CrmLeadConversion", fields: [convertedOpportunityId], references: [id], onDelete: SetNull)
  /// Every deal (past + present) that hangs off this contact. GHL
  /// model — one contact → many opportunities over time.
  opportunities        CrmOpportunity[] @relation("CrmOpportunityContact")
  companyId            String           @default("00000000-0000-0000-0000-000000000001") @map("company_id")

  @@index([companyId, status])
  @@index([companyId, assignedSetterId])
  @@index([companyId, source])
  @@index([companyId, deletedAt])
  // Dedupe lookups hit these on every create.
  @@index([companyId, email])
  @@index([companyId, phone])
  @@map("crm_leads")
}

// ============================================
// CRM — BULK ACTIONS LOG
// ============================================

/// One bulk operation initiated from the CRM board. Persisted so the
/// Bulk Actions tab can render an audit trail (who ran what, when it
/// finished, how many rows it touched, and whether any failed).
///
/// For P0 the runner is synchronous — every action row starts at
/// COMPLETE or FAILED; the RUNNING state exists so a later async
/// worker can flip it without another migration.
enum CrmBulkActionStatus {
  RUNNING
  COMPLETE
  FAILED
}

/// The kind of write a bulk job performs. Delete is the only op for
/// P0; Move / Assign are placeholders reserved for later phases so
/// the enum + history filters don't need re-shipping.
enum CrmBulkActionOperation {
  DELETE
  MOVE_STAGE
  ASSIGN_CLOSER
}

/// The entity a bulk job targets. Kept broad so contact + lead bulk
/// actions can share this log later without a schema fork.
enum CrmBulkActionTargetType {
  OPPORTUNITY
  LEAD
  CONTACT
}

model CrmBulkAction {
  id         String                  @id @default(uuid())
  /// Human-friendly auto-generated name — surfaced in the history
  /// table's "Action label" column.
  label      String
  operation  CrmBulkActionOperation
  targetType CrmBulkActionTargetType @map("target_type")
  status     CrmBulkActionStatus     @default(RUNNING)

  targetCount  Int @default(0) @map("target_count")
  successCount Int @default(0) @map("success_count")
  failureCount Int @default(0) @map("failure_count")

  /// Inputs the job was launched with (target ids, target stage,
  /// etc.). JSON so the shape can evolve per-operation without a
  /// migration.
  params       Json?
  /// First error message when the job failed / partial-failed.
  errorMessage String? @map("error_message") @db.Text

  actorId String? @map("actor_id")
  actor   User?   @relation("CrmBulkActionActor", fields: [actorId], references: [id], onDelete: SetNull)

  createdAt   DateTime  @default(now()) @map("created_at")
  completedAt DateTime? @map("completed_at")
  companyId   String    @default("00000000-0000-0000-0000-000000000001") @map("company_id")

  @@index([companyId, createdAt])
  @@index([companyId, operation])
  @@index([companyId, status])
  @@map("crm_bulk_actions")
}

// ============================================
// CRM — SAVED FILTER VIEWS
// ============================================

/// A saved filter set on the Opportunities board — the "smart lists"
/// pattern from HighLevel. Each view is private to its owner for
/// P0; a later phase can add tenant-shared views by flipping
/// isShared to true. The full filter shape (stageIds, statuses,
/// assigneeIds, value range, close-date range, etc.) is persisted
/// as JSON so schema doesn't need to change every time a facet is
/// added or renamed.
model CrmOpportunityView {
  id         String   @id @default(uuid())
  name       String
  /// Owner — SetNull on user delete so shared/legacy views survive.
  ownerId    String?  @map("owner_id")
  owner      User?    @relation("CrmOpportunityViewOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  /// Serialised OpportunityFilterState — shape is validated on write
  /// (crmOpportunityViewSchema) so bad data can't reach the client.
  filterJson Json     @map("filter_json")
  /// Sort order across all views for one owner — powers drag-reorder
  /// of tabs in a later phase.
  orderIndex Int      @default(0) @map("order_index")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  companyId  String   @default("00000000-0000-0000-0000-000000000001") @map("company_id")

  @@index([companyId, ownerId, orderIndex])
  @@map("crm_opportunity_views")
}

/// Smart-list saved views on the Contacts inbox — GHL's "Smart
/// Lists" tab row above the table. Private per owner. filterJson
/// stores the serialised ContactsFilterState + sort + per-page
/// so the tab restores the whole surface state on click.
model CrmContactView {
  id         String   @id @default(uuid())
  name       String
  ownerId    String?  @map("owner_id")
  owner      User?    @relation("CrmContactViewOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  filterJson Json     @map("filter_json")
  orderIndex Int      @default(0) @map("order_index")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  companyId  String   @default("00000000-0000-0000-0000-000000000001") @map("company_id")

  @@index([companyId, ownerId, orderIndex])
  @@map("crm_contact_views")
}
